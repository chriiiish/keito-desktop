{
  "name": "keito-timer",
  "productName": "Keito Timer",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Desktop task-switching timer for Keito",
  "license": "GPL-3.0-only",
  "author": "Chris Lloyd",
  "scripts": {
    "test": "vitest run --exclude 'test/contract/**'",
    "test:watch": "vitest --exclude 'test/contract/**'",
    "test:contract": "vitest run test/contract",
    "typecheck": "tsc --noEmit",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder --mac --win",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "main": "out/main/index.cjs",
  "build": {
    "appId": "ai.keito.timer",
    "productName": "Keito Timer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "build/tray*.png"
    ],
    "extraResources": [
      "LICENSE"
    ],
    "afterPack": "build/afterPack.cjs",
    "afterAllArtifactBuild": "build/afterAllArtifactBuild.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "artifactName": "Keito-Timer-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon-win.png",
      "artifactName": "Keito-Timer-${version}-Windows.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Keito Timer"
    }
  }
}
